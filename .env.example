# Пример окружения аудио-приложения (читают app/settings.py, core/config.py
# и core/TTS/tts_engine.py). Значения ниже — фактические значения по умолчанию
# из кода; раскомментируйте, чтобы переопределить. Относительные пути
# разрешаются от текущей рабочей директории процесса.
# Примечание: .env-файл никто автоматически не загружает — переменные должны
# быть выставлены в окружении до запуска (экспорт, systemd, docker и т.п.).

# Корень единого хранилища; внутри создаются embeddings/, voices_TTS/ и out_TTS/.
#STORAGE_DIR=storage

# Папка эмбеддингов зарегистрированных пользователей.
#EMBEDDINGS_DIR=storage/embeddings

# Папка клонов голосов (reference.wav + meta.json каждого голоса).
#VOICES_DIR=storage/voices_TTS

# Устройство синтеза TTS: cpu | cuda | cuda:0. Если не задано —
# автоопределение (cuda при доступности CUDA, иначе cpu).
#DEVICE=cpu

# Лимит длительности одной генерации TTS, сек (превышение -> HTTP 503).
#TTS_MAX_SECONDS=45

# Частота дискретизации reference.wav при клонировании голоса, Гц.
#TTS_SAMPLE_RATE=24000

# Реализация attention для Qwen3-TTS: sdpa (по умолчанию) или
# flash_attention_2 — только если установлен пакет flash-attn.
#TTS_ATTN_IMPLEMENTATION=sdpa
