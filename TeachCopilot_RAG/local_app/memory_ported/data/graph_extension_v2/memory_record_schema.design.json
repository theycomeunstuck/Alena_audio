{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeachCopilot learner memory record V2",
  "description": "Closed persisted-record schema. Extraction omits server-assigned IDs, dates, counts and use policy; contracts_v2.py derives the model-facing schema from this file.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "turn_id",
        "quote"
      ],
      "additionalProperties": false
    },
    "memory_link": {
      "type": "object",
      "properties": {
        "relation": {
          "type": "string",
          "enum": [
            "corrects_answer",
            "same_pattern_as",
            "supported_by",
            "rechecks",
            "response_to",
            "mentioned_again",
            "related_to",
            "followed_by"
          ]
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "record",
            "turn"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "relation",
        "target_kind",
        "target_id"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "enum": [
        "child_error",
        "child_correction",
        "supported_attempt",
        "uncertain_observation",
        "learning_success",
        "unfinished_work",
        "interest_candidate",
        "session_preference_candidate",
        "incidental_fact",
        "source_correction"
      ]
    },
    "occurred_on": {
      "type": "string",
      "format": "date"
    },
    "last_seen": {
      "type": "string",
      "format": "date"
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1
    },
    "topic_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "interpretation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "interpretation_status": {
      "type": "string",
      "enum": [
        "explicit",
        "explicit_with_assistance",
        "ambiguous",
        "candidate",
        "single_independent_observation"
      ]
    },
    "support_level": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "none",
        "none_before_attempt",
        "hint_question",
        "visual",
        "joint",
        "unknown"
      ]
    },
    "support_evidence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/evidence"
        }
      ]
    },
    "independent_recheck": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "unknown",
        "not_observed",
        "one_success_only",
        "unknown_without_support",
        "success",
        "failure"
      ]
    },
    "recheck_evidence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/evidence"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory_link"
      }
    },
    "interest_operation": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "add",
        "remove",
        "avoid",
        "allow"
      ]
    },
    "interest": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "preference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 300
    },
    "fact": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "claim_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "candidate",
        "explicit"
      ]
    },
    "retention_class": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "session_only",
        "profile_candidate",
        "episodic_personal_fact"
      ]
    },
    "corrects_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "corrected_by_record_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "use_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "record_id",
    "record_type",
    "occurred_on",
    "last_seen",
    "evidence_count",
    "topic_id",
    "context",
    "interpretation",
    "interpretation_status",
    "support_level",
    "support_evidence",
    "independent_recheck",
    "recheck_evidence",
    "evidence",
    "links",
    "interest_operation",
    "interest",
    "preference",
    "fact",
    "claim_status",
    "retention_class",
    "corrects_record_id",
    "corrected_by_record_ids",
    "use_policy"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "child_error"
          }
        }
      },
      "then": {
        "properties": {
          "interpretation_status": {
            "enum": [
              "explicit",
              "explicit_with_assistance",
              "single_independent_observation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "child_correction"
          }
        }
      },
      "then": {
        "properties": {
          "interpretation_status": {
            "enum": [
              "explicit",
              "explicit_with_assistance",
              "single_independent_observation"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "interpretation_status": {
                  "const": "explicit"
                }
              }
            },
            "then": {
              "properties": {
                "support_level": {
                  "enum": [null, "unknown"]
                },
                "support_evidence": {
                  "const": null
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "supported_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "interpretation_status": {
            "const": "explicit_with_assistance"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "learning_success"
          }
        }
      },
      "then": {
        "properties": {
          "interpretation_status": {
            "enum": [
              "explicit",
              "explicit_with_assistance",
              "single_independent_observation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "support_level": {
            "enum": [
              null,
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "support_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "support_level": {
            "enum": [
              "none",
              "none_before_attempt",
              "hint_question",
              "visual",
              "joint"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "support_evidence": {
            "type": "object"
          }
        },
        "required": [
          "support_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "independent_recheck": {
            "enum": [
              null,
              "unknown",
              "unknown_without_support"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recheck_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "independent_recheck": {
            "enum": [
              "not_observed",
              "one_success_only",
              "success",
              "failure"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recheck_evidence": {
            "type": "object"
          }
        },
        "required": [
          "recheck_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "child_error"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "child_correction"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "supported_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "uncertain_observation"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interpretation_status": {
            "const": "ambiguous"
          },
          "support_level": {
            "enum": [
              null,
              "unknown",
              "hint_question",
              "visual",
              "joint"
            ]
          },
          "independent_recheck": {
            "enum": [
              null,
              "unknown"
            ]
          },
          "recheck_evidence": {
            "type": "null"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "support_level": {
                  "enum": [
                    "hint_question",
                    "visual",
                    "joint"
                  ]
                }
              },
              "required": ["support_level"]
            },
            "then": {
              "properties": {
                "support_evidence": {
                  "$ref": "#/$defs/evidence"
                }
              },
              "required": ["support_evidence"]
            }
          },
          {
            "if": {
              "properties": {
                "support_level": {
                  "enum": [null, "unknown"]
                }
              },
              "required": ["support_level"]
            },
            "then": {
              "properties": {
                "support_evidence": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "supported_attempt"
          }
        }
      },
      "then": {
        "properties": {
          "support_level": {
            "enum": [
              "hint_question",
              "visual",
              "joint"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "interest_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "const": null
          },
          "interpretation_status": {
            "const": "candidate"
          },
          "interest_operation": {
            "enum": [
              "add",
              "remove",
              "avoid",
              "allow"
            ]
          },
          "interest": {
            "type": "string",
            "minLength": 1
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": "candidate"
          },
          "retention_class": {
            "const": "profile_candidate"
          },
          "corrects_record_id": {
            "const": null
          },
          "support_level": {
            "const": null
          },
          "support_evidence": {
            "const": null
          },
          "independent_recheck": {
            "const": null
          },
          "recheck_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "session_preference_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "const": null
          },
          "interpretation_status": {
            "const": "candidate"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "type": "string",
            "minLength": 1
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": "candidate"
          },
          "retention_class": {
            "const": "session_only"
          },
          "corrects_record_id": {
            "const": null
          },
          "support_level": {
            "const": null
          },
          "support_evidence": {
            "const": null
          },
          "independent_recheck": {
            "const": null
          },
          "recheck_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "incidental_fact"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "const": null
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "claim_status": {
            "const": "explicit"
          },
          "retention_class": {
            "const": "episodic_personal_fact"
          },
          "interpretation_status": {
            "const": "explicit"
          },
          "corrects_record_id": {
            "const": null
          },
          "support_level": {
            "const": null
          },
          "support_evidence": {
            "const": null
          },
          "independent_recheck": {
            "const": null
          },
          "recheck_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "source_correction"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "corrects_record_id": {
            "type": "string",
            "minLength": 1
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "support_level": {
            "const": null
          },
          "support_evidence": {
            "const": null
          },
          "independent_recheck": {
            "const": null
          },
          "recheck_evidence": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "learning_success"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "unfinished_work"
          }
        }
      },
      "then": {
        "properties": {
          "topic_id": {
            "type": "string"
          },
          "interest_operation": {
            "const": null
          },
          "interest": {
            "const": null
          },
          "preference": {
            "const": null
          },
          "fact": {
            "const": null
          },
          "claim_status": {
            "const": null
          },
          "retention_class": {
            "const": null
          },
          "corrects_record_id": {
            "const": null
          }
        }
      }
    }
  ]
}
