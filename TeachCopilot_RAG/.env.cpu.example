TEACHCOPILOT_RUNTIME_PROFILE=cpu_debug
EMBEDDING_DEVICE=cpu
EMBEDDING_MODEL=auto

# OpenAI-compatible local or remote runtime.
# Leave TEACHCOPILOT_CHAT_MODEL empty if the caller/Open WebUI already sends a model.
TEACHCOPILOT_CHAT_API_BASE_URL=http://127.0.0.1:1234/v1
TEACHCOPILOT_CHAT_MODEL=
TEACHCOPILOT_CHAT_TIMEOUT_SEC=180

# Keep streaming disabled until docs/STREAMING_DIAGNOSIS.md is addressed.
TEACHCOPILOT_STREAM_MODE=diagnostic
TEACHCOPILOT_DEBUG_RAG=0

# child_only keeps the old behavior. mapped_or_adult sends unknown users to adult mode.
TEACHCOPILOT_SPEAKER_MODE=child_only

# Profile agent is skipped when PROFILE_LLM_MODEL is empty.
PROFILE_LLM_API_URL=http://127.0.0.1:1234/v1
PROFILE_LLM_MODEL=
PROFILE_UPDATE_INTERVAL=5
