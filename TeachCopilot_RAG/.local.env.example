POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://teachcopilot:replace-with-a-random-local-password@127.0.0.1:5434/teachcopilot_local
OLLAMA_URL=http://127.0.0.1:11435
LOCAL_CHAT_MODEL=gemma4:12b
LOCAL_EMBEDDING_MODEL=bge-m3
LOCAL_CONTEXT_TOKENS=16384
LOCAL_MAX_OUTPUT_TOKENS=1024
LOCAL_REQUEST_TIMEOUT=180
LOCAL_SESSION_HOURS=12
LOCAL_JOB_LEASE_SECONDS=600
LOCAL_AUTONOMOUS_DIVISION_ENABLED=0
# Explicit pilot scope: JSON array of account UUIDs; [] denies everyone.
# Removing this variable permits all students when the feature flag is 1.
LOCAL_AUTONOMOUS_DIVISION_ACCOUNT_IDS=[]
LOCAL_MEMORY_RESPONSE_JOURNAL=.local/memory-worker-responses.sqlite3
LOCAL_CHAT_RESPONSE_JOURNAL=.local/chat-responses.sqlite3
OLLAMA_NO_CLOUD=1
